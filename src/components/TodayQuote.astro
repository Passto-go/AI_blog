---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/ui.js';
import { getDailyQuote } from '../lib/quotes.js';

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
const q = await getDailyQuote(lang);
---
<section class="widget">
  <h4 class="widget-title"><Icon name="quote" size={15} /> {t('widget.quote')}</h4>
  <p class="widget-quote" id="today-quote">{q.text}</p>
  {q.source && <p class="quote-src">— {q.source}</p>}
</section>
