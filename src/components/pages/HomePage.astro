---
import Base from '../../layouts/Base.astro';
import PostCard from '../PostCard.astro';
import ProfileCard from '../ProfileCard.astro';
import TodayQuote from '../TodayQuote.astro';
import Countdown from '../Countdown.astro';
import { getPosts, getCategories } from '../../lib/posts.js';
import { useTranslations } from '../../i18n/ui.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const cats = await getCategories(lang);
---
<Base lang={lang} title={t('home.hero.title')} description={t('site.tagline')}>
  <div class="home">
    <aside class="sidebar">
      <ProfileCard lang={lang} postsCount={posts.length} catsCount={cats.length} />
      <TodayQuote lang={lang} />
      <Countdown lang={lang} />
    </aside>
    <section class="content">
      <h2 class="section-title">{t('home.latest')}</h2>
      {posts.length === 0 ? (
        <p class="empty">{t('home.empty')}</p>
      ) : (
        <div class="post-list">
          {posts.map((p) => <PostCard post={p} lang={lang} />)}
        </div>
      )}
    </section>
  </div>
</Base>
