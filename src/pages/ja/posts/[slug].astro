---
import PostPage from '../../../components/pages/PostPage.astro';
import FourOhFour from '../../404.astro';
import { getPostWithVersions } from '../../../lib/posts.js';

// SSR：每请求现查 Supabase，新文章发布后即刻可访问，无需重新构建
const { slug } = Astro.params;
// getPostWithVersions：按语言级联解析正文版本（目标→英文→中文），并带回各语言可用性
const versions = (await getPostWithVersions(slug, 'ja')) || null;
if (!versions) Astro.response.status = 404;
---
{versions ? <PostPage lang="ja" post={versions.post} versions={versions} /> : <FourOhFour lang="ja" />}
