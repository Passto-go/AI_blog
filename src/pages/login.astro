---
import AdminLayout from '../layouts/AdminLayout.astro';

// 纯客户端应用（supabase-js 在浏览器里运行），无需 SSR，预渲染为静态页
export const prerender = true;
---

<AdminLayout title="写作后台" description="登录后在线撰写与发布文章">
  <div class="wb">

    <!-- ============ 未登录 ============ -->
    <section id="login-view" class="wb-login" hidden>
      <form id="login-form" class="wb-login-card">
        <h1>写作后台</h1>
        <p class="wb-sub">登录后即可撰写、发布文章</p>

        <div id="cfg-note" class="wb-alert" hidden>
          未检测到 Supabase 配置。请在部署平台的环境变量中填入
          <code>PUBLIC_SUPABASE_URL</code> 与 <code>PUBLIC_SUPABASE_ANON_KEY</code> 后重新部署。
        </div>

        <label for="email">邮箱</label>
        <input id="email" type="email" autocomplete="username" placeholder="you@example.com" required />
        <label for="password">密码</label>
        <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" required />

        <button class="btn" type="submit">登录</button>
        <span id="login-msg" class="wb-hint"></span>
      </form>
    </section>

    <!-- ============ 工作台 ============ -->
    <section id="workbench" class="wb-bench" hidden>
      <header class="wb-top">
        <div class="wb-top-left">
          <strong>写作后台</strong>
          <span id="wb-user" class="wb-user"></span>
        </div>
        <div class="wb-top-right">
          <a class="wb-mini-link" href="/" target="_blank" rel="noopener" title="在新标签页打开站点首页">查看站点 ↗</a>
          <button id="logout-btn" class="wb-mini-btn" type="button">退出</button>
        </div>
      </header>

      <!-- 模块导航：写作管理 / 评论管理 / 其他功能 -->
      <nav class="wb-modnav" id="wb-modnav">
        <button type="button" data-mod="write" class="on">写作管理</button>
        <button type="button" data-mod="comments">评论管理</button>
        <button type="button" data-mod="misc">其他功能</button>
      </nav>

      <!-- ============ 模块一：写作管理 ============ -->
      <section id="mod-write" class="wb-module">
        <div class="wb-grid">
          <!-- ---------- 编辑列 ---------- -->
          <div class="wb-main">
            <div class="wb-card">
              <input id="f-title" class="wb-title" placeholder="文章标题" />

              <div class="wb-meta">
                <div class="wb-seg" id="f-lang" role="group" aria-label="语言">
                  <button type="button" data-v="zh" class="on">中文</button>
                  <button type="button" data-v="en">EN</button>
                  <button type="button" data-v="ja">日本語</button>
                </div>
                <input id="f-category" class="wb-cat" list="cat-list" placeholder="分类（可选）" />
                <datalist id="cat-list"></datalist>
                <div class="wb-seg" id="f-status" role="group" aria-label="状态">
                  <button type="button" data-v="draft" class="on">草稿</button>
                  <button type="button" data-v="published">已发布</button>
                </div>
              </div>

              <div class="wb-tabs" id="wb-tabs">
                <button type="button" data-tab="edit" class="on">编辑</button>
                <button type="button" data-tab="preview">预览</button>
                <button type="button" data-tab="split">分屏</button>
              </div>

              <div class="wb-editor" id="wb-editor" data-tab="edit">
                <textarea id="f-content" placeholder="用 Markdown 写作…&#10;&#10;# 二级标题&#10;正文、**加粗**、`代码`、![图片](https://…)"></textarea>
                <div id="preview" class="wb-preview content"></div>
              </div>

              <div class="wb-toolbar">
                <label class="wb-upload" title="上传图片到 Supabase 存储并插入正文">
                  插图
                  <input id="f-image" type="file" accept="image/*" multiple hidden />
                </label>
                <span id="upload-msg" class="wb-hint"></span>
              </div>

              <div class="wb-trbar">
                <span class="wb-trbar-label">一键翻译</span>
                <button id="tr-en-btn" class="wb-tr-btn" type="button" title="把当前文章译成英文并填入编辑器，检查后发布即创建/更新英文版">译成英文</button>
                <button id="tr-ja-btn" class="wb-tr-btn" type="button" title="把当前文章译成日文并填入编辑器，检查后发布即创建/更新日文版">译成日文</button>
                <span id="lang-state" class="wb-langstate"></span>
                <span id="tr-msg" class="wb-hint"></span>
              </div>

              <details class="wb-more">
                <summary>更多设置（Slug / 摘要 / 封面）</summary>
                <div class="wb-more-body">
                  <label>Slug<input id="f-slug" placeholder="留空自动生成" /><small id="slug-hint" class="wb-hint"></small></label>
                  <label>摘要<input id="f-excerpt" placeholder="一句话摘要" /></label>
                  <label>封面 URL<input id="f-cover" placeholder="https://…" /></label>
                  <label>分类 Slug<input id="f-catslug" placeholder="留空自动生成" /></label>
                </div>
              </details>

              <div class="wb-actions">
                <button id="save-draft-btn" class="btn btn-ghost" type="button">存草稿</button>
                <button id="publish-btn" class="btn" type="button">发布并上线</button>
                <button id="new-btn" class="btn btn-ghost" type="button">新建</button>
                <button id="delete-btn" class="btn btn-danger" type="button" hidden>删除</button>
                <span id="save-msg" class="wb-hint"></span>
              </div>
            </div>
          </div>

          <!-- ---------- 列表列 ---------- -->
          <aside class="wb-side">
            <div class="wb-card">
              <div class="wb-side-head">
                <strong>文章</strong>
                <span id="wb-count" class="wb-hint"></span>
              </div>
              <input id="wb-search" class="wb-search" type="search" placeholder="搜索标题…" />
              <div class="wb-filter" id="wb-filter">
                <button type="button" data-f="all" class="on">全部</button>
                <button type="button" data-f="published">已发布</button>
                <button type="button" data-f="draft">草稿</button>
              </div>
              <ul id="post-list" class="wb-list"></ul>
            </div>
          </aside>
        </div>
      </section>

      <!-- ============ 模块二：评论管理 ============ -->
      <section id="mod-comments" class="wb-module" hidden>
        <div class="wb-card" id="cm-card">
          <div class="wb-side-head">
            <strong>评论管理</strong>
            <span id="cm-count" class="wb-hint"></span>
          </div>
          <div class="wb-filter" id="cm-filter">
            <button type="button" data-f="all" class="on">全部</button>
            <button type="button" data-f="pending">待审核</button>
            <button type="button" data-f="approved">已通过</button>
            <button type="button" data-f="rejected">未通过</button>
          </div>
          <ul id="cm-list" class="wb-list"></ul>
        </div>
      </section>

      <!-- ============ 模块三：其他功能 ============ -->
      <section id="mod-misc" class="wb-module" hidden>
        <div class="wb-grid-misc">
          <div class="wb-card" id="cd-card">
            <div class="wb-side-head"><strong>首页倒计时</strong></div>
            <label class="wb-field">名称<input id="cd-name" placeholder="如：元旦" /></label>
            <label class="wb-field">日期<input id="cd-date" type="date" /></label>
            <button id="cd-save" class="btn" type="button">保存倒计时</button>
            <span id="cd-msg" class="wb-hint"></span>
          </div>

          <div class="wb-card" id="cat-card">
            <div class="wb-side-head">
              <strong>分类管理</strong>
              <span id="cat-count" class="wb-hint"></span>
            </div>
            <p class="wb-hint wb-cat-note">重命名会同步修改该分类下所有文章的分类名与 URL（slug）；改名后旧的分类链接将失效。</p>
            <ul id="cat-list-manage" class="wb-list"></ul>
          </div>
        </div>
      </section>
    </section>
  </div>
</AdminLayout>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { marked } from 'marked';
  import { site } from '../data/site.js';

  const URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const DRAFT_KEY = 'wb-local-draft';
  const $ = (id) => document.getElementById(id);

  // 必须在模块作用域声明：下方各函数（loadList / persist / uploadImages 等）
  // 均在顶层定义，若把 client 关在 else 块内会因词法作用域取不到而抛 ReferenceError
  let supabase = null;

  // 当前编辑态
  const state = { id: '', lang: 'zh', status: 'draft', filter: 'all', query: '', saving: false };

  const LANGS = { zh: '中文', en: 'EN', ja: '日本語' };

  function slugify(str) {
    return String(str).trim().toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-\u4e00-\u9fa5]/g, '');
  }

  function setMsg(text, kind = '') {
    const el = $('save-msg');
    el.textContent = text;
    el.dataset.kind = kind;
  }

  // ---------- 视图切换 ----------
  function showLogin(msg) {
    $('login-view').hidden = false;
    $('workbench').hidden = true;
    if (msg) $('login-msg').textContent = msg;
  }

  async function showWorkbench() {
    $('login-view').hidden = true;
    $('workbench').hidden = false;
    const { data } = await supabase.auth.getUser();
    $('wb-user').textContent = data?.user?.email || '';
    await loadList();
    loadCountdown();
    loadComments();
  }

  // ---------- 模块切换（写作管理 / 评论管理 / 其他功能） ----------
  const MODULES = ['write', 'comments', 'misc'];
  function switchModule(name) {
    if (!MODULES.includes(name)) return;
    MODULES.forEach((m) => { $('mod-' + m).hidden = m !== name; });
    document.querySelectorAll('#wb-modnav [data-mod]').forEach((b) => {
      b.classList.toggle('on', b.dataset.mod === name);
    });
    if (name === 'comments') loadComments();
    if (name === 'misc') { loadCountdown(); loadCatManage(); }
  }

  // ---------- 首页倒计时（存于 site_settings） ----------
  async function loadCountdown() {
    try {
      const { data, error } = await supabase
        .from('site_settings').select('value').eq('key', 'countdown').maybeSingle();
      if (!error && data?.value) {
        $('cd-name').value = data.value.name || data.value.label || '';
        const t = (data.value.target || '').slice(0, 10);
        if (t) $('cd-date').value = t;
      }
    } catch {}
  }

  async function saveCountdown() {
    const name = $('cd-name').value.trim();
    const date = $('cd-date').value;
    const msg = $('cd-msg');
    if (!name || !date) { msg.textContent = '请填写名称和日期'; msg.dataset.kind = 'err'; return; }
    msg.textContent = '保存中…'; msg.dataset.kind = '';
    const target = date + 'T00:00:00';
    const { error } = await supabase
      .from('site_settings')
      .upsert({ key: 'countdown', value: { name, target }, updated_at: new Date().toISOString() });
    if (error) { msg.textContent = '保存失败：' + error.message; msg.dataset.kind = 'err'; }
    else { msg.textContent = '已保存 ✓ 首页刷新即生效'; msg.dataset.kind = 'ok'; }
  }

  // ---------- 评论管理（管理员：可读/改/删全部评论） ----------
  const cmState = { filter: 'all' };

  function cmStatusOf(c) {
    if (c.approved) return 'approved';
    if (c.rejected) return 'rejected';
    return 'pending';
  }
  const CM_STATUS_LABEL = { approved: '已通过', rejected: '未通过', pending: '待审核' };

  async function loadComments() {
    const ul = $('cm-list');
    if (!ul) return;
    let q = supabase.from('comments').select('*').order('created_at', { ascending: false });
    const { data, error } = await q;
    if (error) { ul.innerHTML = '<li class="wb-empty">读取失败：' + error.message + '</li>'; return; }
    const all = data || [];
    const counts = { all: all.length, pending: 0, approved: 0, rejected: 0 };
    all.forEach((c) => { counts[cmStatusOf(c)]++; });
    $('cm-count').textContent = `待审 ${counts.pending} · 通过 ${counts.approved} · 未过 ${counts.rejected}`;
    const rows = all.filter((c) => cmState.filter === 'all' || cmStatusOf(c) === cmState.filter);
    if (!rows.length) { ul.innerHTML = '<li class="wb-empty">没有匹配的评论</li>'; return; }
    ul.innerHTML = '';
    rows.forEach((c) => ul.appendChild(renderCommentItem(c)));
  }

  function renderCommentItem(c) {
    const li = document.createElement('li');
    li.className = 'wb-cm-item' + (c.parent_id ? ' wb-cm-item--reply' : '');
    const st = cmStatusOf(c);
    const d = c.created_at ? new Date(c.created_at).toLocaleString('zh-CN') : '';
    const metaExtra = [];
    if (c.is_admin) metaExtra.push('<span class="wb-cm-badge wb-cm-badge--admin">管理员</span>');
    if (c.parent_id) metaExtra.push('<span class="wb-cm-replyof">↳ 回复</span>');
    const body = document.createElement('div');
    body.className = 'wb-cm-body';
    body.innerHTML =
      `<div class="wb-cm-meta">
         <span class="wb-cm-author">${escapeHtml(c.author || '匿名')}</span>
         <span class="wb-badge wb-cm-status wb-cm-status--${st}">${CM_STATUS_LABEL[st]}</span>
         ${metaExtra.join('')}
         <span class="wb-cm-page">${escapeHtml(c.page || '')}</span>
       </div>
       <div class="wb-cm-text">${escapeHtml(c.content || '')}</div>
       <div class="wb-cm-date">${d}</div>`;
    li.appendChild(body);

    const acts = document.createElement('div');
    acts.className = 'wb-cm-acts';

    if (st !== 'approved') {
      const approve = document.createElement('button');
      approve.type = 'button';
      approve.className = 'wb-cm-act wb-cm-approve';
      approve.textContent = '通过';
      approve.onclick = () => moderate(c.id, true, false);
      acts.appendChild(approve);
    }
    if (st !== 'rejected') {
      const reject = document.createElement('button');
      reject.type = 'button';
      reject.className = 'wb-cm-act wb-cm-reject';
      reject.textContent = '驳回';
      reject.onclick = () => moderate(c.id, false, true);
      acts.appendChild(reject);
    }
    // 管理员回复入口
    const replyBtn = document.createElement('button');
    replyBtn.type = 'button';
    replyBtn.className = 'wb-cm-act wb-cm-reply';
    replyBtn.textContent = '回复';
    replyBtn.onclick = () => toggleReplyForm(c, li, replyBtn);
    acts.appendChild(replyBtn);

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'wb-cm-act wb-cm-del';
    del.textContent = '删除';
    del.onclick = async () => {
      if (!confirm('确定删除这条评论？此操作不可恢复。')) return;
      const { error } = await supabase.from('comments').delete().eq('id', c.id);
      if (error) { alert('删除失败：' + error.message); return; }
      await loadComments();
    };
    acts.appendChild(del);
    li.appendChild(acts);
    return li;
  }

  // 切换某条评论的内联回复框
  function toggleReplyForm(c, li, btn) {
    const exist = li.querySelector('.wb-cm-replybox');
    if (exist) { exist.remove(); return; }
    const box = document.createElement('div');
    box.className = 'wb-cm-replybox';
    box.innerHTML = '<textarea class="wb-cm-replytext" placeholder="以管理员身份回复，发送后即发即显"></textarea>';
    const row = document.createElement('div');
    row.className = 'wb-cm-replyrow';
    const send = document.createElement('button');
    send.type = 'button';
    send.className = 'wb-cm-act wb-cm-send';
    send.textContent = '发送回复';
    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'wb-cm-act';
    cancel.textContent = '取消';
    cancel.onclick = () => box.remove();
    send.onclick = async () => {
      const ta = box.querySelector('.wb-cm-replytext');
      const val = (ta.value || '').trim();
      if (!val) { alert('回复内容不能为空'); return; }
      send.textContent = '发送中…'; send.disabled = true;
      const ok = await replyTo(c, val);
      if (ok) { box.remove(); await loadComments(); }
      else { send.textContent = '发送回复'; send.disabled = false; }
    };
    row.append(send, cancel);
    box.appendChild(row);
    li.appendChild(box);
    box.querySelector('.wb-cm-replytext').focus();
  }

  // 管理员回复：作为一条 is_admin=true、approved=true 的评论插入，parent_id 关联原评论
  async function replyTo(parent, content) {
    const { error } = await supabase.from('comments').insert({
      page: parent.page,
      author: (site && site.author) || '老一贯',
      email: '',
      content: content.slice(0, 1000),
      approved: true,
      rejected: false,
      parent_id: parent.id,
      is_admin: true,
    });
    if (error) { alert('回复失败：' + error.message); return false; }
    return true;
  }

  async function moderate(id, approved, rejected) {
    const { error } = await supabase
      .from('comments').update({ approved, rejected }).eq('id', id);
    if (error) { alert('操作失败：' + error.message); return; }
    await loadComments();
  }

  // ---------- 分类管理（合并 / 删除；重命名暂未开放） ----------
  async function loadCatManage() {
    const ul = $('cat-list-manage');
    if (!ul) return;
    let rows;
    try {
      const { data, error } = await supabase.from('posts').select('category, category_slug');
      if (error) { ul.innerHTML = '<li class="wb-empty">读取失败：' + error.message + '</li>'; return; }
      const map = new Map();
      (data || []).forEach((p) => {
        const name = (p.category || '').trim();
        if (!name) return;
        const slug = (p.category_slug || '').trim() || slugify(name) || 'uncategorized';
        if (!map.has(slug)) map.set(slug, { name, slug, count: 0 });
        map.get(slug).count++;
      });
      rows = [...map.values()].sort((a, b) => b.count - a.count);
    } catch (e) {
      ul.innerHTML = '<li class="wb-empty">读取失败：' + (e?.message || e) + '</li>';
      return;
    }
    $('cat-count').textContent = '共 ' + rows.length + ' 个';
    if (!rows.length) { ul.innerHTML = '<li class="wb-empty">还没有分类</li>'; return; }
    ul.innerHTML = '';
    rows.forEach((c) => ul.appendChild(renderCatItem(c, rows)));
  }

  function renderCatItem(c, all) {
    const li = document.createElement('li');
    li.className = 'wb-cat-item';
    const main = document.createElement('div');
    main.className = 'wb-cat-row';
    main.innerHTML =
      '<span class="wb-cat-name">' + escapeHtml(c.name) + '</span>' +
      '<span class="wb-cat-slug">/' + escapeHtml(c.slug) + '</span>' +
      '<span class="wb-cat-count">' + c.count + ' 篇</span>';
    li.appendChild(main);

    const acts = document.createElement('div');
    acts.className = 'wb-cat-acts';

    const renameBtn = document.createElement('button');
    renameBtn.type = 'button';
    renameBtn.className = 'wb-cat-act';
    renameBtn.textContent = '重命名';
    renameBtn.onclick = () => startRename(li, c, all);

    const sel = document.createElement('select');
    sel.className = 'wb-cat-select';
    all.forEach((o) => {
      if (o.slug !== c.slug) {
        const opt = document.createElement('option');
        opt.value = o.slug; opt.textContent = o.name;
        sel.appendChild(opt);
      }
    });
    const mergeBtn = document.createElement('button');
    mergeBtn.type = 'button';
    mergeBtn.className = 'wb-cat-act';
    mergeBtn.textContent = '合并到…';
    mergeBtn.onclick = async () => {
      const target = all.find((o) => o.slug === sel.value);
      if (!target) return;
      if (!confirm('把「' + c.name + '」下的 ' + c.count + ' 篇文章合并到「' + target.name + '」？')) return;
      mergeBtn.textContent = '合并中…'; mergeBtn.disabled = true;
      const ok = await mergeCategory(c, target);
      if (ok) { await loadCatManage(); }
      else { mergeBtn.textContent = '合并到…'; mergeBtn.disabled = false; }
    };

    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'wb-cat-act wb-cat-del';
    del.textContent = '删除';
    del.onclick = async () => {
      if (!confirm('删除分类「' + c.name + '」？其下 ' + c.count + ' 篇文章将归入「未分类」。')) return;
      del.textContent = '删除中…'; del.disabled = true;
      const ok = await deleteCategory(c);
      if (ok) { await loadCatManage(); }
      else { del.textContent = '删除'; del.disabled = false; }
    };

    acts.append(renameBtn, sel, mergeBtn, del);
    li.appendChild(acts);
    return li;
  }

  // 进入「重命名」内联编辑态
  function startRename(li, c, all) {
    li.innerHTML = '';
    li.className = 'wb-cat-item wb-cat-item--edit';

    const nameInput = document.createElement('input');
    nameInput.className = 'wb-cat-input';
    nameInput.value = c.name;
    nameInput.placeholder = '分类显示名';

    const slugInput = document.createElement('input');
    slugInput.className = 'wb-cat-input';
    slugInput.value = c.slug;
    slugInput.placeholder = 'url-slug';

    const preview = document.createElement('span');
    preview.className = 'wb-cat-slug-preview';
    const renderPreview = () => {
      const s = (slugInput.value.trim() || slugify(nameInput.value) || 'uncategorized');
      preview.textContent = '/' + s;
    };
    nameInput.addEventListener('input', renderPreview);
    slugInput.addEventListener('input', renderPreview);
    renderPreview();

    const msg = document.createElement('span');
    msg.className = 'wb-cat-rename-msg';

    const save = document.createElement('button');
    save.type = 'button';
    save.className = 'wb-cat-act';
    save.textContent = '保存';
    save.onclick = async () => {
      const newName = nameInput.value.trim();
      if (!newName) { msg.textContent = '名称不能为空'; return; }
      let newSlug = slugInput.value.trim();
      if (!newSlug) newSlug = slugify(newName);
      if (!/^[a-z0-9-]+$/.test(newSlug)) { msg.textContent = 'Slug 只能是小写字母、数字和连字符'; return; }
      if (newSlug !== c.slug && all.some((o) => o.slug === newSlug)) { msg.textContent = '该 Slug 已存在'; return; }
      save.textContent = '保存中…'; save.disabled = true;
      const ok = await renameCategory(c, newName, newSlug);
      if (ok) await loadCatManage();
      else { save.textContent = '保存'; save.disabled = false; }
    };

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'wb-cat-act wb-cat-cancel';
    cancel.textContent = '取消';
    cancel.onclick = () => loadCatManage();

    const row1 = document.createElement('div');
    row1.className = 'wb-cat-rename-row';
    row1.append(nameInput, slugInput, preview);
    const row2 = document.createElement('div');
    row2.className = 'wb-cat-rename-row';
    row2.append(save, cancel, msg);
    li.append(row1, row2);
    nameInput.focus();
  }

  async function renameCategory(src, newName, newSlug) {
    // 1) 改写该分类下所有文章的显示名与 slug
    const { error } = await supabase
      .from('posts').update({ category: newName, category_slug: newSlug })
      .eq('category_slug', src.slug);
    if (error) { alert('重命名失败：' + error.message); return false; }
    try {
      // 2) 级联：原本指向旧 slug 的别名，改指向新 slug（处理 A→B→C 链路）
      await supabase.from('category_aliases').update({ new_slug: newSlug }).eq('new_slug', src.slug);
      // 3) 写入旧 slug → 新 slug 映射（若旧 slug 已有别名则覆盖）
      await supabase.from('category_aliases').upsert(
        { old_slug: src.slug, new_slug: newSlug },
        { onConflict: 'old_slug' }
      );
    } catch (e) {
      // 别名写入失败不应回滚文章改名，仅提示（重定向会缺失，但内容已就位）
      console.warn('[cat] 写入 slug 别名失败', e);
    }
    return true;
  }

  async function mergeCategory(src, dst) {
    const { error } = await supabase
      .from('posts').update({ category: dst.name, category_slug: dst.slug })
      .eq('category_slug', src.slug);
    if (error) { alert('合并失败：' + error.message); return false; }
    return true;
  }

  async function deleteCategory(src) {
    const { error } = await supabase
      .from('posts').update({ category: '', category_slug: 'uncategorized' })
      .eq('category_slug', src.slug);
    if (error) { alert('删除失败：' + error.message); return false; }
    return true;
  }

  // ---------- 一键翻译（经 /api/translate 服务端中转调 LLM） ----------
  // 约定：中文原文用 base slug，英/日译文用 base-en / base-ja 后缀（posts.slug 全局唯一）。
  function baseSlug(slug) {
    return String(slug || '').replace(/-(en|ja)$/, '');
  }

  function setTrMsg(text, kind = '') {
    const el = $('tr-msg');
    el.textContent = text;
    el.dataset.kind = kind;
  }

  // 译文状态行：显示当前文章的英/日版本是否已存在（按 base slug 匹配内存全量表），
  // 已存在的可点击直接载入该版本。
  function updateLangState() {
    const el = $('lang-state');
    if (!el) return;
    const cur = state.id ? allPosts.find((p) => p.id === state.id) : null;
    const rawSlug = cur?.slug || $('f-slug').value.trim();
    if (!rawSlug) { el.innerHTML = ''; return; }
    const base = baseSlug(rawSlug);
    const parts = [];
    for (const code of ['en', 'ja']) {
      const row = allPosts.find(
        (p) => p.id !== state.id && baseSlug(p.slug) === base && (p.lang || 'zh') === code
      );
      parts.push(
        row
          ? `<button type="button" class="wb-langstate-btn has" data-lang="${code}" title="载入${LANGS[code]}版（点击）">${LANGS[code]} ✓</button>`
          : `<span class="wb-langstate-btn">${LANGS[code]} —</span>`
      );
    }
    el.innerHTML = parts.join('');
    el.querySelectorAll('button[data-lang]').forEach((b) => {
      b.onclick = () => {
        const row = allPosts.find(
          (p) => baseSlug(p.slug) === base && (p.lang || 'zh') === b.dataset.lang
        );
        if (row) { setForm(row); setMsg(`已载入《${row.title}》`); }
      };
    });
  }

  async function translateTo(targetLang) {
    const title = $('f-title').value.trim();
    const excerpt = $('f-excerpt').value.trim();
    const content = $('f-content').value;
    if (!title || !content.trim()) { setTrMsg('请先填写标题和正文', 'err'); return; }
    if (content.length > 20000) { setTrMsg('正文超过 2 万字，请拆成多篇再译', 'err'); return; }

    // 是否已有该语言的译文行：有 → 载入其框架后覆盖内容（更新）；无 → 以当前文章为蓝本新建
    const cur = state.id ? allPosts.find((p) => p.id === state.id) : null;
    const base = baseSlug(cur?.slug || $('f-slug').value || slugify(title));
    const existing = allPosts.find(
      (p) => p.id !== state.id && baseSlug(p.slug) === base && (p.lang || 'zh') === targetLang
    );
    const langName = targetLang === 'en' ? '英文' : '日文';

    if (!confirm(
      existing
        ? `已存在${langName}版文章。将载入该版本框架，用新译文覆盖其内容，发布后更新线上文章。继续？`
        : `将把当前文章译成${langName}并填入编辑器（不会自动保存）。发布时会创建新的${langName}版文章。继续？`
    )) return;

    const btns = [$('tr-en-btn'), $('tr-ja-btn')];
    btns.forEach((b) => { b.disabled = true; b.style.opacity = '.55'; b.style.pointerEvents = 'none'; });
    setTrMsg(`正在翻译成${langName}，免费层繁忙时最长等待约 3 分钟…`, '');
    // 超时护栏：覆盖服务端 503 退避重试（最长约 166 秒）+ Gemini 生成的全程，避免永久转圈
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 200000);
    try {
      const { data: sd } = await supabase.auth.getSession();
      const token = sd?.session?.access_token;
      if (!token) { setTrMsg('会话已过期，请重新登录后再试', 'err'); return; }

      const resp = await fetch('/api/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ title, excerpt, content, targetLang }),
        signal: ctrl.signal,
      });
      const result = await resp.json().catch(() => ({}));
      if (!resp.ok) {
        setTrMsg(result.error || `翻译失败（HTTP ${resp.status}）`, 'err');
        return;
      }

      if (existing) {
        setForm(existing); // 保留英文版自己的分类/封面/发布状态，只覆盖三项内容
      } else {
        // 切到新建态：发布时 INSERT 译文行，不会覆盖中文原文
        state.id = '';
        state.lang = targetLang;
        syncSeg($('f-lang'), targetLang);
        const slugNow = $('f-slug').value.trim();
        if (!slugNow || slugNow === base) $('f-slug').value = `${base}-${targetLang}`;
        $('delete-btn').hidden = true;
      }
      $('f-title').value = result.title;
      $('f-excerpt').value = result.excerpt || '';
      $('f-content').value = result.content;
      renderPreview();
      updateSlugHint();
      saveLocalDraft();
      setTrMsg(
        `✓ 译文已填入${result.parts > 1 ? `（长文分 ${result.parts} 段翻译，请重点检查段落衔接）` : ''}。请通读检查后点击「发布」`,
        'ok'
      );
    } catch (e) {
      if (e?.name === 'AbortError') {
        setTrMsg('翻译超时（200 秒）。Gemini 免费层可能持续繁忙，稍后再点一次试试', 'err');
      } else {
        setTrMsg('网络错误：' + (e?.message || '请求失败') + '（若挂代理，试试切换节点）', 'err');
      }
    } finally {
      clearTimeout(timer);
      btns.forEach((b) => { b.disabled = false; b.style.opacity = ''; b.style.pointerEvents = ''; });
    }
  }

  // ---------- 表单 ----------
  function setForm(p = {}) {
    state.id = p.id || '';
    $('f-title').value = p.title || '';
    $('f-slug').value = p.slug || '';
    $('f-category').value = p.category || '';
    $('f-catslug').value = p.category_slug || '';
    $('f-excerpt').value = p.excerpt || '';
    $('f-cover').value = p.cover || '';
    $('f-content').value = p.content || '';
    state.lang = p.lang || 'zh';
    state.status = p.published === false ? 'draft' : (p.id ? 'published' : 'draft');
    syncSeg($('f-lang'), state.lang);
    syncSeg($('f-status'), state.status);
    $('delete-btn').hidden = !p.id;
    setMsg('');
    renderPreview();
    updateSlugHint();
    updateLangState();
    saveLocalDraft();
  }

  function syncSeg(container, value) {
    container.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.v === value));
  }

  function collectRow() {
    const title = $('f-title').value.trim();
    const category = $('f-category').value.trim();
    return {
      title,
      slug: $('f-slug').value.trim() || autoSlug(title, state.lang),
      lang: state.lang,
      category,
      category_slug: $('f-catslug').value.trim() || slugify(category) || 'uncategorized',
      excerpt: $('f-excerpt').value.trim(),
      cover: $('f-cover').value.trim(),
      content: $('f-content').value,
      published: state.status === 'published',
    };
  }

  // 自动生成 Slug。按站点约定：中文用基础名，英/日文加 -en / -ja 后缀，
  // 这样同一篇文章的各语言版本不会因 slug 相同而撞唯一约束。
  function autoSlug(title, lang) {
    const base = slugify(title) || 'post-' + Date.now();
    const suffix = lang === 'en' ? '-en' : lang === 'ja' ? '-ja' : '';
    return base + suffix;
  }

  // 实时提示最终会使用的 Slug
  function updateSlugHint() {
    const el = $('slug-hint');
    if (!el) return;
    const manual = $('f-slug').value.trim();
    el.textContent = manual
      ? '将使用：' + manual
      : '留空则自动生成：' + autoSlug($('f-title').value || '（标题）', state.lang);
  }

  // 保存期间禁用按钮，防止快速连点导致两次 INSERT 同一 slug
  function setButtonsBusy(busy) {
    ['save-draft-btn', 'publish-btn', 'delete-btn', 'new-btn'].forEach((id) => {
      const b = $(id);
      if (!b) return;
      b.disabled = busy;
      b.style.opacity = busy ? '.55' : '';
      b.style.pointerEvents = busy ? 'none' : '';
    });
  }

  // 解析出可用的 Slug。
  // - 自动生成的：撞车就静默加 -2 / -3 … 直到可用
  // - 用户手填的：撞车就报错让用户自己改（不擅自改动用户输入）
  async function resolveSlug(base, excludeId, manual) {
    let candidate = base;
    for (let i = 0; i < 50; i++) {
      let q = supabase.from('posts').select('id').eq('slug', candidate).limit(1);
      if (excludeId) q = q.neq('id', excludeId);
      const { data, error } = await q;
      if (error) return { slug: candidate, conflict: false, changed: false };
      if (!data || data.length === 0) {
        return { slug: candidate, conflict: false, changed: candidate !== base };
      }
      if (manual) return { slug: candidate, conflict: true, changed: false };
      candidate = `${base}-${i + 2}`;
    }
    return { slug: candidate, conflict: false, changed: true };
  }

  // ---------- 保存 ----------
  async function persist() {
    const row = collectRow();
    if (!row.title) { setMsg('请先填写标题', 'err'); $('f-title').focus(); return null; }

    // 防重复提交：快速连点「发布」会出现两次 INSERT 同一 slug，后一次必撞唯一约束
    if (state.saving) return null;
    state.saving = true;
    setButtonsBusy(true);

    let error;
    try {
      // Slug 唯一性预处理（posts_slug_key 是全局唯一，不按语言区分）
      const manual = $('f-slug').value.trim() !== '';
      const resolved = await resolveSlug(row.slug, state.id || null, manual);
      if (resolved.conflict) {
        setMsg(`Slug「${resolved.slug}」已被其他文章占用，请到「更多设置」换一个`, 'err');
        $('f-slug').focus();
        return null;
      }
      row.slug = resolved.slug;
      if (resolved.changed) {
        setMsg(`Slug 已自动改为可用的：${resolved.slug}`);
        updateSlugHint();
      }

      if (state.id) {
        ({ error } = await supabase.from('posts').update(row).eq('id', state.id));
      } else {
        const r = await supabase.from('posts').insert({ ...row, published_at: new Date().toISOString() });
        error = r.error;
        if (!error && r.data?.[0]) state.id = r.data[0].id;
      }
    } finally {
      state.saving = false;
      setButtonsBusy(false);
    }

    if (error) {
      // 兜底：万一预处理之后仍撞约束（并发等），给出可操作的提示
      if (/duplicate key|posts_slug_key|unique/i.test(error.message)) {
        setMsg(`保存失败：Slug「${row.slug}」已存在。请打开「更多设置」修改 Slug 后重试`, 'err');
      } else {
        setMsg('保存失败：' + error.message, 'err');
      }
      return null;
    }
    $('delete-btn').hidden = !state.id;
    return row;
  }

  async function saveDraft() {
    state.status = 'draft';
    syncSeg($('f-status'), 'draft');
    const row = await persist();
    if (!row) return;
    setMsg('草稿已保存', 'ok');
    clearLocalDraft();
    await loadList();
  }

  async function publish() {
    state.status = 'published';
    syncSeg($('f-status'), 'published');
    const row = await persist();
    if (!row) return;
    // SSR 模式：写入 Supabase 即对全站生效，读者刷新即可看到，无需触发任何构建
    setMsg('已发布 ✓ 已即时生效，读者刷新即可看到', 'ok');
    clearLocalDraft();
    await loadList();
  }

  // ---------- 文章列表 ----------
  let allPosts = [];

  function renderList() {
    const ul = $('post-list');
    ul.innerHTML = '';
    const q = state.query.trim().toLowerCase();
    const rows = allPosts.filter((p) => {
      const okFilter = state.filter === 'all'
        || (state.filter === 'published' ? p.published : !p.published);
      const okQuery = !q || (p.title || '').toLowerCase().includes(q);
      return okFilter && okQuery;
    });

    $('wb-count').textContent = `${rows.length} / ${allPosts.length}`;

    if (!rows.length) {
      ul.innerHTML = '<li class="wb-empty">没有匹配的文章</li>';
      return;
    }

    rows.forEach((p) => {
      const li = document.createElement('li');
      li.className = 'wb-item' + (p.id === state.id ? ' on' : '');

      const main = document.createElement('button');
      main.type = 'button';
      main.className = 'wb-item-main';
      const d = p.published_at ? new Date(p.published_at).toLocaleDateString('zh-CN') : '';
      main.innerHTML =
        `<span class="wb-item-title">${escapeHtml(p.title || '(无标题)')}</span>
         <span class="wb-item-meta">
           <span class="wb-badge">${LANGS[p.lang] || p.lang || 'zh'}</span>
           <span class="wb-badge ${p.published ? 'is-live' : 'is-draft'}">${p.published ? '已发布' : '草稿'}</span>
           <span class="wb-date">${d}</span>
         </span>`;
      main.onclick = () => { setForm(p); setMsg('已载入《' + p.title + '》'); };

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'wb-item-del';
      del.textContent = '删除';
      del.title = '删除这篇文章';
      del.onclick = async () => {
        if (!confirm('确定删除《' + (p.title || '无标题') + '》？此操作不可恢复。')) return;
        const { error } = await supabase.from('posts').delete().eq('id', p.id);
        if (error) { alert('删除失败：' + error.message); return; }
        if (state.id === p.id) setForm({});
        await loadList();
      };

      li.append(main, del);
      ul.append(li);
    });
  }

  async function loadList() {
    const { data, error } = await supabase
      .from('posts').select('*').order('published_at', { ascending: false });
    if (error) { $('post-list').innerHTML = '<li class="wb-empty">读取失败：' + error.message + '</li>'; return; }
    allPosts = data || [];
    renderCategories();
    renderList();
    updateLangState();
  }

  function renderCategories() {
    const names = [...new Set(allPosts.map((p) => p.category).filter(Boolean))].sort();
    $('cat-list').innerHTML = names.map((n) => `<option value="${escapeHtml(n)}"></option>`).join('');
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  // ---------- Markdown 预览 ----------
  let previewTimer;
  function renderPreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => {
      $('preview').innerHTML = marked.parse($('f-content').value || '') || '<p class="wb-hint">暂无内容</p>';
    }, 120);
  }

  // ---------- 本地自动保存 ----------
  let autosaveTimer;
  function saveLocalDraft() {
    clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(() => {
      const snap = { ...collectRow(), id: state.id };
      if (!snap.title && !snap.content) return;
      try { localStorage.setItem(DRAFT_KEY, JSON.stringify(snap)); } catch {}
    }, 700);
  }

  function clearLocalDraft() { try { localStorage.removeItem(DRAFT_KEY); } catch {} }

  function restoreLocalDraft() {
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      if (!raw) return;
      const snap = JSON.parse(raw);
      if (snap.id) return; // 只恢复「新建」场景
      setForm(snap);
      setMsg('已恢复上次未保存的内容', 'ok');
    } catch {}
  }

  // ---------- 图片上传 ----------
  async function uploadImages(files) {
    const msg = $('upload-msg');
    const ok = [];
    for (const file of files) {
      msg.textContent = `上传中 ${file.name}…`;
      const path = `${Date.now()}-${slugify(file.name) || 'image'}`;
      const { error } = await supabase.storage.from('images').upload(path, file, { upsert: true });
      if (error) { msg.textContent = '上传失败：' + error.message; return; }
      ok.push(supabase.storage.from('images').getPublicUrl(path).data.publicUrl);
    }
    if (ok.length) {
      insertAtCursor(ok.map((u) => `![](${u})`).join('\n'));
      msg.textContent = `已插入 ${ok.length} 张图片 ✓`;
    }
  }

  function insertAtCursor(text) {
    const ta = $('f-content');
    const start = ta.selectionStart ?? ta.value.length;
    const end = ta.selectionEnd ?? ta.value.length;
    const before = ta.value.slice(0, start);
    const after = ta.value.slice(end);
    const pad = (before && !before.endsWith('\n') ? '\n' : '') + text + '\n';
    ta.value = before + pad + after;
    ta.focus();
    ta.selectionStart = ta.selectionEnd = before.length + pad.length;
    renderPreview();
    saveLocalDraft();
  }

  // ---------- 未配置 Supabase ----------
  if (!URL || !KEY) {
    $('cfg-note').hidden = false;
    $('login-form').querySelector('button').disabled = true;
    showLogin();
  } else {
    supabase = createClient(URL, KEY, { auth: { persistSession: true, autoRefreshToken: true } });

    // 登录
    $('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('login-msg').textContent = '登录中…';
      const { error } = await supabase.auth.signInWithPassword({
        email: $('email').value, password: $('password').value,
      });
      if (error) { $('login-msg').textContent = '失败：' + error.message; return; }
      $('login-msg').textContent = '';
      restoreLocalDraft();
      await showWorkbench();
    });

    // 退出
    $('logout-btn').addEventListener('click', async () => {
      await supabase.auth.signOut();
      showLogin();
    });

    // 模块导航：写作管理 / 评论管理 / 其他功能
    $('wb-modnav').querySelectorAll('button').forEach((b) => {
      b.onclick = () => switchModule(b.dataset.mod);
    });

    // 操作按钮
    $('save-draft-btn').onclick = saveDraft;
    $('publish-btn').onclick = publish;
    $('new-btn').onclick = () => { setForm({}); setMsg(''); };
    $('cd-save').onclick = saveCountdown;

    // 一键翻译
    $('tr-en-btn').onclick = () => translateTo('en');
    $('tr-ja-btn').onclick = () => translateTo('ja');

    // 评论管理：状态筛选
    $('cm-filter').querySelectorAll('button').forEach((b) => b.onclick = () => {
      cmState.filter = b.dataset.f;
      $('cm-filter').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      loadComments();
    });

    // 评论管理：实时订阅（管理员侧，审核/删除后自动刷新）
    try {
      supabase
        .channel('admin-comments')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'comments' }, () => loadComments())
        .subscribe();
    } catch (e) { console.warn('[admin] comments realtime 订阅失败（不影响手动刷新）', e); }
    $('delete-btn').onclick = async () => {
      if (!state.id) return;
      const { data: cur } = await supabase.from('posts').select('title').eq('id', state.id).single();
      if (!confirm('确定删除《' + (cur?.title || '无标题') + '》？此操作不可恢复。')) return;
      const { error } = await supabase.from('posts').delete().eq('id', state.id);
      if (error) { setMsg('删除失败：' + error.message, 'err'); return; }
      setForm({});
      setMsg('已删除', 'ok');
      await loadList();
    };

    // 分段控件：语言 / 状态
    $('f-lang').querySelectorAll('button').forEach((b) => b.onclick = () => {
      state.lang = b.dataset.v; syncSeg($('f-lang'), state.lang); updateSlugHint(); saveLocalDraft();
    });
    $('f-status').querySelectorAll('button').forEach((b) => b.onclick = () => {
      state.status = b.dataset.v; syncSeg($('f-status'), state.status);
    });

    // 视图 Tab
    $('wb-tabs').querySelectorAll('button').forEach((b) => b.onclick = () => {
      $('wb-tabs').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      $('wb-editor').dataset.tab = b.dataset.tab;
      if (b.dataset.tab !== 'edit') renderPreview();
    });

    // 列表筛选 / 搜索
    $('wb-filter').querySelectorAll('button').forEach((b) => b.onclick = () => {
      state.filter = b.dataset.f;
      $('wb-filter').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      renderList();
    });
    $('wb-search').addEventListener('input', (e) => { state.query = e.target.value; renderList(); });

    // 正文输入：预览 + 自动保存
    $('f-content').addEventListener('input', () => { renderPreview(); saveLocalDraft(); });
    ['f-title', 'f-category', 'f-excerpt', 'f-cover', 'f-slug', 'f-catslug'].forEach((id) => {
      $(id).addEventListener('input', () => {
        if (id === 'f-title') updateSlugHint();
        saveLocalDraft();
      });
    });

    // 图片上传
    $('f-image').addEventListener('change', (e) => {
      if (e.target.files?.length) uploadImages([...e.target.files]);
      e.target.value = '';
    });

    // ---------- 粘贴：图片直接上传插入；网页复制的图片转 Markdown ----------
    // 纯文本粘贴走浏览器默认行为（已验证可用），这里只补齐图片场景
    $('f-content').addEventListener('paste', (e) => {
      const cd = e.clipboardData;
      if (!cd) return;

      // 1) 剪贴板中的图片文件：截图、或从文件夹复制的图片
      const files = [];
      if (cd.items) {
        for (const it of cd.items) {
          if (it.kind === 'file' && it.type.startsWith('image/')) {
            const f = it.getAsFile();
            if (f) files.push(f);
          }
        }
      }
      if (!files.length && cd.files) {
        for (const f of cd.files) if (f.type.startsWith('image/')) files.push(f);
      }
      if (files.length) {
        e.preventDefault();
        uploadImages(files);
        return;
      }

      // 2) 从网页复制的图片：text/html 中含 <img src="...">，转成 Markdown 图片语法
      const html = cd.getData('text/html');
      if (html && /<img\b[^>]*\ssrc=/i.test(html)) {
        const urls = [...html.matchAll(/<img\b[^>]*?\ssrc=["']([^"']+)["']/gi)]
          .map((m) => m[1])
          .filter((u) => /^https?:\/\//i.test(u));
        if (urls.length) {
          e.preventDefault();
          insertAtCursor(urls.map((u) => `![](${u})`).join('\n'));
          $('upload-msg').textContent = `已插入 ${urls.length} 张图片 ✓`;
        }
      }
    });

    // 已有会话直接进工作台
    supabase.auth.getSession()
      .then(({ data }) => { if (data.session) showWorkbench(); else showLogin(); })
      .catch(() => showLogin());

    // D2：会话状态监听——主动退出 / 令牌过期 / 异地登出 任一发生都自动回到登录界面
    try {
      supabase.auth.onAuthStateChange((_event, session) => {
        if (!session) showLogin();
      });
    } catch (e) { console.warn('[admin] 会话监听注册失败（不影响手动退出）', e); }
  }
</script>
