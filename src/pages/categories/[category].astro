---
import CategoryPage from '../../components/pages/CategoryPage.astro';
import FourOhFour from '../404.astro';
import { getCategories } from '../../lib/posts.js';

// SSR：每请求现查 Supabase，新分类/新文章发布后即刻可访问，无需重新构建
const { category } = Astro.params;
const cat = (await getCategories('zh')).find((c) => c.slug === category) || null;
if (!cat) Astro.response.status = 404;
---
{cat ? <CategoryPage lang="zh" slug={cat.slug} /> : <FourOhFour lang="zh" />}
